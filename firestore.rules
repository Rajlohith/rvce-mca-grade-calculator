rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // RVCE MCA student email format
    function isRvceMcaEmail() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email.matches(
               '^[a-zA-Z]+([.][a-zA-Z]+)*[.]mca(24|25|26|27)@rvce[.]edu[.]in$'
             );
    }

    // Block this specific student
    function isBlockedEmail() {
      return request.auth != null &&
             request.auth.token.email == "kirankumarab.mca25@rvce.edu.in";
    }

    // Users can only read/write their own marks document
    match /userMarks/{userId} {
      allow read, write: if request.auth != null &&
                          request.auth.uid == userId &&
                          request.auth.token.firebase.identities["google.com"] != null &&
                          isRvceMcaEmail() &&
                          !isBlockedEmail();
    }

    // Public FAQ and course reference data
    match /publicData/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}